{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["private/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.js?action=$1"
    },
    {
      "src": "/api/export",
      "dest": "/api/admin.js?action=export"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/$",
      "dest": "/public/index.html"
    },
    {
      "src": "/kit/?$",
      "dest": "/api/kit.js"
    },
    {
      "src": "/kit/deck\\.pdf$",
      "dest": "/api/kit-file.js?f=deck"
    },
    {
      "src": "/kit/(.*)",
      "status": 302,
      "headers": { "Location": "/kit" }
    },
    {
      "src": "/demo/?$",
      "dest": "/public/demo/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
