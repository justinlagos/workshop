{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.js?action=$1"
    },
    {
      "src": "/api/export",
      "dest": "/api/admin.js?action=export"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/$",
      "dest": "/public/index.html"
    },
    {
      "src": "/kit/?$",
      "dest": "/public/kit/index.html"
    },
    {
      "src": "/demo/?$",
      "dest": "/public/demo/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
