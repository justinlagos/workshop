# The Build Session — environment template.
# Copy to .env for local dev. NEVER commit real values.
# On Netlify: Site settings -> Environment variables (same names).

PORT=3000
# Public site URL (used for Stripe return links + email links)
SITE_URL=http://localhost:3000

MAX_SEATS=8
ADMIN_EMAIL=justin@motionplaylabs.com

# Protects /api/admin/* and /api/export. Long random string.
ADMIN_TOKEN=change-me-long-random

# Email (Resend) — server-side only, never in frontend code.
# Domain motionplaylabs.com is verified in Resend.
RESEND_API_KEY=
RESEND_FROM=MotionPlay Labs <hello@motionplaylabs.com>

# Payments (Stripe, TEST mode until explicit approval to go live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key is NOT needed server-side; Checkout Sessions are created
# server-side and applicants pay on Stripe-hosted pages.

# Local dev only: Blobs migration script credentials (NOT used by the app itself)
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
