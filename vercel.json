{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "private/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.js?action=$1"
    },
    {
      "src": "/api/export",
      "dest": "/api/admin.js?action=export"
    },
    {
      "src": "/api/kit-start",
      "dest": "/api/kit.js?action=start"
    },
    {
      "src": "/api/kit-verify",
      "dest": "/api/kit.js?action=verify"
    },
    {
      "src": "/api/kit-logout",
      "dest": "/api/kit.js?action=logout"
    },
    {
      "src": "/api/kit-mail",
      "dest": "/api/kit.js?action=mail"
    },
    {
      "src": "/api/kit-ask",
      "dest": "/api/kit.js?action=ask"
    },
    {
      "src": "/api/kit-form",
      "dest": "/api/kit.js?action=form"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/$",
      "dest": "/public/index.html"
    },
    {
      "src": "/feedback/?$",
      "dest": "/api/kit.js?action=feedback"
    },
    {
      "src": "/kit/?$",
      "dest": "/api/kit.js"
    },
    {
      "src": "/kit/deck\\.pdf$",
      "dest": "/api/kit.js?action=file&f=deck"
    },
    {
      "src": "/kit/(.*)",
      "status": 302,
      "headers": {
        "Location": "/kit"
      }
    },
    {
      "src": "/cohort-01/?$",
      "dest": "/public/cohort-01.html"
    },
    {
      "src": "/demo/?$",
      "dest": "/public/demo/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
